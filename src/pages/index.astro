---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Portfolio Interactive</title>
        <!-- Match scene.background (0x4a6fa5 * 0.1) so hard reload is not white -->
        <style is:inline>
            html,
            body {
                background: #070b10;
            }
        </style>
    </head>
    <body>
        <div class="FakeScroll" aria-hidden="true"></div>

        <div id="canvas-container"></div>

        <div id="scroll-wrapper">
            <div
                id="content"
                class="text-slate-200 text-shadow-red-900 relative flex flex-col z-2 px-10"
            >
                <div id="home" class="flex flex-col justify-center min-h-screen relative">

                    <!-- Sección de entrada - Nombre y título -->
                    <div class="home-content flex gap-6">
                        <!-- Vertical line -->
                        <div class="vertical-line-wrapper flex flex-col items-center gap-3 py-2">
                            <span class="little-dot"></span>
                            <span class="vertical-line"></span>
                            <span class="little-dot"></span>
                        </div>

                        <!-- Content -->
                        <div class="flex flex-col gap-6">
                            <div class="flex flex-col gap-3">
                                <div class="flex gap-4 delay-1">
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="line line-4 gradient-green horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-3 gradient-blue horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                </div>

                                <div class="flex gap-4 delay-2">
                                    <span
                                        class="line line-2 gradient-gray horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-4 gradient-orange horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                </div>

                                <div class="flex gap-4 delay-3">
                                    <span
                                        class="line line-5 gradient-pink horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-4 gradient-gray horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                </div>
                            </div>

                            <div class="title mb-9 horizontal-fade-in">
                                <h1 class="text-7xl font-bold text-slate-200 mb-2 tracking-tight">
                                    Juan Aressi
                                </h1>

                                <div class="text-rotator relative mt-2 min-h-[2.5rem]">
                                    <h3
                                        data-translate="header.title"
                                        class="text-2xl text-gray mb-2 absolute top-0 left-0 rotating-text active"
                                    ></h3>

                                    <h3
                                        data-translate="header.profession"
                                        class="text-2xl text-gray mb-2 absolute top-0 left-0 rotating-text"
                                    ></h3>
                                </div>
                            </div>

                            <div class="flex flex-col gap-3">
                                <div class="flex gap-4 delay-2">
                                    <span
                                        class="line line-5 gradient-gray horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-2 gradient-blue horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                </div>

                                <div class="flex gap-4 delay-1">
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="line line-2 gradient-orange horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="line line-3 gradient-green horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-5"
                                    ></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Work Experience -->
                <div id="work" class="flex flex-col justify-center min-h-screen">
                    <div class="work-panel right-aligned-panel flex gap-6">
                        <!-- Vertical line -->
                        <div
                            class="vertical-line-wrapper flex flex-col items-center gap-3 pt-4 pb-2"
                        >
                            <span class="little-dot"></span>
                            <span class="vertical-line"></span>
                            <span class="little-dot"></span>
                        </div>

                        <div class="flex flex-col gap-6">
                            <h2
                                data-translate="work.title"
                                class="m-0 text-5xl horizontal-fade-in horizontal-fade-in-1"
                            ></h2>

                            <div class="flex flex-col gap-3">
                                <div class="flex gap-4 delay-1">
                                    <span
                                        class="line line-5 gradient-blue horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-2 gradient-orange horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                </div>

                                <div class="flex gap-4 delay-2">
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="line line-2 gradient-gray horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="line line-3 gradient-pink horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-5"
                                    ></span>
                                </div>
                            </div>

                            <div class="flex flex-col gap-3">
                                <!-- Persiscal -->
                                <div class="flex items-center company-item" data-job-id="persiscal">
                                    <span class="line line-5 gradient-pink w-0"></span>
                                    <span class="text-2xl">Persiscal</span>
                                </div>

                                <!-- Ignitix -->
                                <div class="flex items-center company-item" data-job-id="ignitix">
                                    <span class="line line-4 gradient-green w-0"></span>
                                    <span class="text-2xl">Ignitix</span>
                                </div>

                                <!-- Capgemini -->
                                <div class="flex items-center company-item" data-job-id="capgemini">
                                    <span class="line line-5 gradient-blue w-0"></span>
                                    <span class="text-2xl">Capgemini</span>
                                </div>

                                <!-- Secco -->
                                <div class="flex items-center company-item" data-job-id="secco">
                                    <span class="line line-3 gradient-pink w-0"></span>
                                    <span class="text-2xl">Secco</span>
                                </div>

                                <!-- SACSI -->
                                <div class="flex items-center company-item" data-job-id="sacsi">
                                    <span class="line line-4 gradient-orange w-0"></span>
                                    <span class="text-2xl">SACSI</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!--
                Projects (disabled for now)
                <div id="projects" class="flex flex-col justify-center min-h-screen">
                    <div class="flex gap-6">
                        <div
                            class="vertical-line-wrapper flex flex-col items-center gap-3 pt-4 pb-2"
                        >
                            <span class="little-dot"></span>
                            <span class="vertical-line"></span>
                            <span class="little-dot"></span>
                        </div>

                        <div class="flex flex-col gap-6">
                            <h2
                                data-translate="projects.title"
                                class="m-0 text-5xl horizontal-fade-in horizontal-fade-in-1"
                            ></h2>

                            <div class="flex flex-col gap-3">
                                <div class="flex gap-4 delay-1">
                                    <span
                                        class="line line-5 gradient-green horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-2 gradient-blue horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                </div>

                                <div class="flex gap-4 delay-2">
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="line line-2 gradient-gray horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="line line-3 gradient-orange horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-5"
                                    ></span>
                                </div>
                            </div>

                            <div class="flex flex-col gap-3">
                                <a
                                    class="flex items-center company-item"
                                    href="https://github.com/JuanAressi"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <span class="line line-4 gradient-blue w-0"></span>
                                    <span
                                        class="text-2xl"
                                        data-translate="projects.item-1"
                                    ></span>
                                </a>

                                <a
                                    class="flex items-center company-item"
                                    href="https://github.com/JuanAressi"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <span class="line line-3 gradient-pink w-0"></span>
                                    <span
                                        class="text-2xl"
                                        data-translate="projects.item-2"
                                    ></span>
                                </a>

                                <a
                                    class="flex items-center company-item"
                                    href="https://github.com/JuanAressi"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <span class="line line-5 gradient-green w-0"></span>
                                    <span
                                        class="text-2xl"
                                        data-translate="projects.item-3"
                                    ></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                -->

                <!-- About Me -->
                <div id="about" class="flex flex-col justify-center min-h-screen text-slate-200">
                    <div class="flex gap-6">
                        <!-- Vertical line -->
                        <div
                            class="vertical-line-wrapper flex flex-col items-center gap-3 pt-4 pb-2"
                        >
                            <span class="little-dot"></span>
                            <span class="vertical-line"></span>
                            <span class="little-dot"></span>
                        </div>

                        <div class="flex flex-col gap-6">
                            <h2
                                data-translate="about.title"
                                class="m-0 text-5xl horizontal-fade-in horizontal-fade-in-1"
                            >
                                Hi, I'm Juan
                            </h2>

                            <div class="flex flex-col gap-3">
                                <div class="flex gap-4 delay-1">
                                    <span
                                        class="line line-5 gradient-orange horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-2 gradient-gray horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                </div>

                                <div class="flex gap-4 delay-2">
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="line line-2 gradient-green horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="line line-3 gradient-pink horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-5"
                                    ></span>
                                </div>
                            </div>

                            <div
                                class="flex w-full max-w-2xl flex-col gap-2 text-xl"
                                data-about-copy
                            >
                                <p data-translate="about.paragraph-1"></p>

                                <p data-translate="about.paragraph-2"></p>

                                <p data-translate="about.paragraph-3"></p>

                                <p data-translate="about.paragraph-4"></p>
                            </div>

                            <div class="flex flex-col gap-3">
                                <div class="flex gap-4 delay-1">
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-4 gradient-pink horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="line line-3 gradient-green horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                </div>

                                <div class="flex gap-4 delay-2">
                                    <span
                                        class="line line-2 gradient-gray horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-4 gradient-orange horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                </div>

                                <div class="flex gap-4 delay-3">
                                    <span
                                        class="line line-5 gradient-green horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-4 gradient-gray horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Contact -->
                <div id="contact" class="flex flex-col justify-center min-h-screen">
                    <div class="right-aligned-panel flex gap-6">
                        <!-- Vertical line -->
                        <div
                            class="vertical-line-wrapper flex flex-col items-center gap-3 pt-4 pb-2"
                        >
                            <span class="little-dot"></span>
                            <span class="vertical-line"></span>
                            <span class="little-dot"></span>
                        </div>

                        <div class="flex flex-col gap-6">
                            <h2
                                data-translate="contact.title"
                                class="m-0 text-5xl horizontal-fade-in horizontal-fade-in-1"
                            ></h2>

                            <div class="flex flex-col gap-3">
                                <div class="flex gap-4 delay-1">
                                    <span
                                        class="line line-4 gradient-green horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="line line-2 gradient-blue horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                </div>

                                <div class="flex gap-4 delay-2">
                                    <span
                                        class="dot horizontal-fade-in horizontal-fade-in-1"
                                    ></span>
                                    <span
                                        class="line line-3 gradient-pink horizontal-fade-in horizontal-fade-in-2"
                                    ></span>
                                    <span
                                        class="square horizontal-fade-in horizontal-fade-in-3"
                                    ></span>
                                    <span
                                        class="line line-2 gradient-gray horizontal-fade-in horizontal-fade-in-4"
                                    ></span>
                                </div>
                            </div>

                            <div class="flex flex-col gap-3">
                                <!-- Email -->
                                <a
                                    class="flex items-center company-item"
                                    href="mailto:Juan.Aressi@hotmail.com"
                                >
                                    <span class="text-2xl flex items-center gap-2 flex-row-reverse">
                                        <svg
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.5"
                                            stroke="currentColor"
                                            class="size-6 shrink-0"
                                            aria-hidden="true"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M21.75 9v.906a2.25 2.25 0 0 1-1.183 1.981l-6.478 3.488M2.25 9v.906a2.25 2.25 0 0 0 1.183 1.981l6.478 3.488m8.839 2.51-4.66-2.51m0 0-1.023-.55a2.25 2.25 0 0 0-2.134 0l-1.022.55m0 0-4.661 2.51m16.5 1.615a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V8.844a2.25 2.25 0 0 1 1.183-1.981l7.5-4.039a2.25 2.25 0 0 1 2.134 0l7.5 4.039a2.25 2.25 0 0 1 1.183 1.98V19.5Z"
                                            />
                                        </svg>
                                        <span class="line line-5 gradient-blue w-0"></span>

                                        <span data-translate="contact.email"></span>
                                    </span>
                                </a>

                                <!-- GitHub -->
                                <a
                                    class="flex items-center company-item"
                                    href="https://github.com/JuanAressi"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <span class="text-2xl flex items-center gap-2 flex-row-reverse">
                                        <svg
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="size-6 shrink-0"
                                            aria-hidden="true"
                                        >
                                            <path
                                                d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                                            />
                                            <path d="M9 18c-4.51 2-5-2-7-2" />
                                        </svg>
                                        <span class="line line-2 gradient-orange w-0"></span>
                                        <span data-translate="contact.github"></span>
                                    </span>
                                </a>

                                <!-- LinkedIn -->
                                <a
                                    class="flex items-center company-item"
                                    href="https://www.linkedin.com/in/juan-aressi"
                                    target="_blank"
                                    rel="noopener noreferrer"
                                >
                                    <span class="text-2xl flex items-center gap-2 flex-row-reverse">
                                        <svg
                                            width="24"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="1.5"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="size-6 shrink-0"
                                            aria-hidden="true"
                                        >
                                            <path
                                                d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                                            />
                                            <rect width="4" height="12" x="2" y="9" />
                                            <circle cx="4" cy="4" r="2" />
                                        </svg>
                                        <span class="line line-4 gradient-pink w-0"></span>
                                        <span data-translate="contact.linkedin"></span>
                                    </span>
                                </a>

                                <!-- Download CV -->
                                <a
                                    class="flex items-center company-item"
                                    href={`${import.meta.env.BASE_URL}assets/Juan-Aressi-CV.pdf`}
                                    download
                                >
                                    <span class="text-2xl flex items-center gap-2 flex-row-reverse">
                                        <svg
                                            fill="none"
                                            viewBox="0 0 24 24"
                                            stroke-width="1.5"
                                            stroke="currentColor"
                                            class="size-6 shrink-0"
                                            aria-hidden="true"
                                        >
                                            <path
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                d="M12 3v12m0 0-4-4m4 4 4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
                                            />
                                        </svg>
                                        <span class="line line-3 gradient-green w-0"></span>

                                        <span data-translate="contact.cv"></span>
                                    </span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Barra de navegación inferior -->
        <nav id="bottom-nav" class="glass fixed py-2 px-10 rounded-4xl">
            <div class="relative flex justify-between items-center w-full">
                <div class="flex gap-[2rem]">
                    <!-- Home -->
                    <button
                        type="button"
                        data-nav="home"
                        class="group relative cursor-pointer bg-transparent border-0 flex items-center justify-center size-11"
                        aria-label="Home"
                    >
                        <span class="nav-home-circle" aria-hidden="true"></span>
                        <span class="nav-label" data-translate="navbar.home"></span>
                    </button>

                    <!-- My Work -->
                    <button
                        type="button"
                        data-nav="work"
                        class="group relative cursor-pointer bg-transparent border-0 p-2.5"
                        aria-label="My Work"
                    >
                        <svg
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="size-6 text-slate-200 transition-all duration-500 group-hover:rotate-y-360 group-hover:-translate-y-2 group-hover:text-indigo-500"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 0 0 .75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 0 0-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0 1 12 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 0 1-.673-.38m0 0A2.18 2.18 0 0 1 3 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 0 1 3.413-.387m7.5 0V5.25A2.25 2.25 0 0 0 13.5 3h-3a2.25 2.25 0 0 0-2.25 2.25v.894m7.5 0a48.667 48.667 0 0 0-7.5 0M12 12.75h.008v.008H12v-.008Z"
                            />
                        </svg>
                        <span class="nav-label" data-translate="navbar.work"></span>
                    </button>

                    <!-- About me -->
                    <button
                        type="button"
                        data-nav="about"
                        class="group relative cursor-pointer bg-transparent border-0 p-2.5"
                        aria-label="About Me"
                    >
                        <svg
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="size-6 text-slate-200 transition-all duration-500 group-hover:rotate-y-360 group-hover:-translate-y-2 group-hover:text-indigo-500"
                            aria-hidden="true"
                        >
                            <path
